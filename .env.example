# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings → API Keys / Data API).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional: o padrão já é https://advjulianomartins.com.br
# NEXT_PUBLIC_SITE_URL=https://advjulianomartins.com.br

# Opcional: código da meta tag do Google Search Console (só o valor de content="...")
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
